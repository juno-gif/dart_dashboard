# ============================================================
# Backend 환경변수 예시 (backend/.env.example)
# 실제 값은 backend/.env 에 설정 (gitignore됨)
# ============================================================

# ── 서버 전용 키 (절대 클라이언트에 전달 금지) ──
DART_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres

# ── AI 요약 (Story 6.2) ──
# Anthropic Console에서 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── 기업 개요: 임직원수 폴백 (국민연금 사업장 가입자 현황) ──
# data.go.kr에서 "국민연금공단_국민연금 가입 사업장 내역" 활용신청 후 발급되는
# "Decoding" 인증키를 사용하세요 (Encoding 키를 쓰면 이중 인코딩되어 인증 실패).
# 미설정 시 사업보고서 직원현황만 시도하고 폴백은 건너뜁니다.
NPS_API_KEY=

# ── CORS 설정 ──
# 개발: http://localhost:3000
# 프로덕션: Vercel 배포 도메인 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ⚠️ 경고:
#   - DART_API_KEY 와 SUPABASE_SERVICE_KEY 는 서버에서만 사용하세요.
#   - NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
#   - GitHub 등 공개 저장소에 절대 커밋하지 마세요.
